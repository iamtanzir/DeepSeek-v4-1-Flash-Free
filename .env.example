# Copy to .env:  cp .env.example .env
# The setup scripts do this for you and generate WEBUI_SECRET_KEY.

# ---------------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------------
# nano     deepseek-r1:1.5b              ~1.1 GB   any 4 GB machine
# lite     deepseek-r1:8b                ~5.2 GB   8 GB RAM (default, free)
# coder    deepseek-coder:6.7b-instruct  ~3.8 GB   8 GB RAM
# flagship DeepSeek-V4.1-Flash IQ1_M   ~259 GB   288 GB+ RAM/VRAM
# api      remote endpoint, no local model (see bottom)
MODEL=deepseek-r1:8b

# ---------------------------------------------------------------------------
# Ports / bind addresses
# ---------------------------------------------------------------------------
# Keep Ollama on 127.0.0.1. It has NO authentication.
OLLAMA_BIND=127.0.0.1
OLLAMA_PORT=11434
# Open WebUI is the public door; it has accounts.
WEBUI_BIND=0.0.0.0
WEBUI_PORT=3000
PUBLIC_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Open WebUI
# ---------------------------------------------------------------------------
# Generated by the setup scripts. Do not commit a real value.
WEBUI_SECRET_KEY=
ENABLE_SIGNUP=true
# pending = new users need admin approval, user = instant access
DEFAULT_USER_ROLE=pending

# ---------------------------------------------------------------------------
# Optional remote OpenAI-compatible endpoint
# Use this to reach the real DeepSeek-V4.1-Flash without local hardware.
# ---------------------------------------------------------------------------
ENABLE_OPENAI_API=false
# Ollama Cloud: https://ollama.com/v1
# DeepSeek API: https://api.deepseek.com/v1
# OpenRouter:   https://openrouter.ai/api/v1
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Ollama runtime tuning (local overlay)
# ---------------------------------------------------------------------------
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_CONTEXT_LENGTH=8192
# Only used by docker-compose.local.yml
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# OLLAMA_MODELS_DIR=./ollama-models

# ---------------------------------------------------------------------------
# Image pinning (optional; defaults are latest/main)
# ---------------------------------------------------------------------------
# OLLAMA_IMAGE=ollama/ollama:latest
# WEBUI_IMAGE=ghcr.io/open-webui/open-webui:main

# ---------------------------------------------------------------------------
# Cloudflare Tunnel
# ---------------------------------------------------------------------------
TUNNEL_NAME=deepseek-tunnel
PUBLIC_HOSTNAME=ai.yourdomain.com
SERVICE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cloudflare R2 backup (rclone remote name + bucket)
# R2 free tier is 10 GB: enough for lite/coder models, NOT for flagship.
# ---------------------------------------------------------------------------
R2_REMOTE=r2
R2_BUCKET=deepseek-backup
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com
