# Cloudflare Tunnel — locally-managed config example.
#
# Dashboard-managed tunnels (token install) do NOT use this file; the ingress
# rules live in the Zero Trust dashboard.
#
# Locally-managed flow:
#   cloudflared tunnel login
#   cloudflared tunnel create deepseek-tunnel
#   cp config.yml ~/.cloudflared/config.yml   # edit UUID + hostname
#   cloudflared tunnel route dns deepseek-tunnel ai.yourdomain.com
#   sudo cloudflared service install
#   sudo systemctl enable --now cloudflared
#
# Quick test tunnel (URL changes on every restart):
#   cloudflared tunnel --url http://localhost:3000

tunnel: YOUR_TUNNEL_UUID
credentials-file: /root/.cloudflared/YOUR_TUNNEL_UUID.json

ingress:
  - hostname: ai.yourdomain.com
    service: http://localhost:3000
  - service: http_status:404
