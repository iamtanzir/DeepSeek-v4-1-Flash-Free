# Copy to .env and fill in the values.
# Only these keys are used by scripts/backup-r2.sh and restore-r2.sh.

# rclone remote name from configs/rclone-r2.conf.example
R2_REMOTE=r2
R2_BUCKET=deepseek-backup

# Reference only — rclone reads credentials from rclone.conf, not from here.
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY=your_r2_access_key
R2_SECRET_KEY=your_r2_secret_key
R2_ENDPOINT=https://your_r2_account_id.r2.cloudflarestorage.com

# Public URL (used by Open WebUI links)
PUBLIC_URL=https://ai.yourdomain.com
