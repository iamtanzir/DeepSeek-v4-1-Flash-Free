# Open WebUI is configured with environment variables.
# The compose stack reads these from .env — this file is a reference only.
#
# Connection
OLLAMA_BASE_URL=http://ollama:11434        # container-to-container name
# Optional remote OpenAI-compatible endpoint (Ollama Cloud / DeepSeek / OpenRouter)
ENABLE_OPENAI_API=false
OPENAI_API_BASE_URL=
OPENAI_API_KEY=

# Accounts
WEBUI_SECRET_KEY=                          # generated by setup.sh; keep stable
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending                  # pending = admin approval required

# Public URL (used for links and OAuth callbacks)
WEBUI_URL=http://localhost:3000

# Model shown first in the picker
DEFAULT_MODELS=deepseek-r1:8b

# Change these in .env, not here.
